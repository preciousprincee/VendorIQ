# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file - it is (and must stay) listed in .gitignore.

SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Leave blank for local dev (uses SQLite). In production, paste in Supabase's
# CONNECTION POOLING string (Project Settings -> Database -> Connection
# pooling -> "Transaction" mode, port 6543) - not the direct connection.
# Looks like: postgresql://postgres.xxxx:[password]@aws-0-xx.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_CONN_MAX_AGE=0

# Get a free key at https://console.groq.com/keys - required for the AI Assistant page.
GROQ_API_KEY=

# Optional - override the AI model if Groq deprecates the current default
# (see https://console.groq.com/docs/deprecations). Leave commented out
# (not just blank - an empty value still overrides the code default with
# an empty string) to use the built-in default.
# GROQ_MODEL=openai/gpt-oss-120b

# Email (optional) - used to send invoices to customers.
# Leave EMAIL_HOST blank to have emails print to the console instead (fine for local dev).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@vendoriq.app

# --- Production tuning (optional) ---
# Redis URL to share one cache across every gunicorn worker/dyno. Leave blank
# to use a local in-memory cache (fine for a single instance).
REDIS_URL=
THROTTLE_RATE_ANON=30/min
THROTTLE_RATE_USER=300/min

# Login lockout - temporarily blocks further attempts against one EMAIL
# (not IP) after this many failed logins within the window, regardless of
# which IP they're coming from. Self-healing (no admin unlock needed) -
# see the longer comment in settings.py for why a permanent lockout would
# itself be a denial-of-service vector.
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
# Set to False once you've locked down exact production origins instead of
# allowing every *.vercel.app preview deployment.
CORS_ALLOW_VERCEL_PREVIEWS=True
WEB_CONCURRENCY=3
GUNICORN_THREADS=4

# --- Google sign-in (optional) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# ("OAuth client ID" -> "Web application"). Leave both blank to simply not
# offer Google sign-in - email/password login keeps working either way.
# See vendoriq-django/README.md "Google sign-in setup" for the full steps.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Billing / subscriptions ---
# Starting price of the Pro plan in Naira, no separators (e.g. 5000) - only
# used to seed the database the FIRST time the app runs. After that, the
# actual price is a live setting controlled from Django Admin (Revenue &
# Billing > Pro plan price), not this variable - change it there instead;
# it takes effect immediately, no redeploy needed. See
# apps/billing/models.py::get_pro_price_ngn.
PRO_PRICE_NGN=5000

# Starting free-trial length in days - only used to seed the database the
# FIRST time the app runs. After that, the actual trial length is a live
# setting controlled from Django Admin (Revenue & Billing > Free trial
# length), not this variable - change it there instead; it takes effect
# immediately for every account, including ones currently mid-trial. See
# apps/billing/models.py::get_trial_period_days.
TRIAL_PERIOD_DAYS=14

# --- Error monitoring (optional) ---
# Create a free project at https://sentry.io, then Settings -> Client Keys
# (DSN) to get this URL. Leave blank to just not send error reports
# anywhere - the app behaves identically either way, this is purely additive.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_SEND_PII=False
