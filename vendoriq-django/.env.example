# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file - it is (and must stay) listed in .gitignore.

SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public URL of the deployed frontend (no trailing slash) - used to build
# absolute asset links (like the logo) in emails. Defaults to the first
# CORS_ALLOWED_ORIGINS entry if left blank.
FRONTEND_URL=

# --- Database ---
# Leave blank for local dev (uses SQLite). In production, paste in Supabase's
# CONNECTION POOLING string (Project Settings -> Database -> Connection
# pooling -> "Transaction" mode, port 6543) - not the direct connection.
# Looks like: postgresql://postgres.xxxx:[password]@aws-0-xx.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_CONN_MAX_AGE=0

# Get a free key at https://console.groq.com/keys - required for the AI Assistant page.
GROQ_API_KEY=

# Optional - override the AI model if Groq deprecates the current default
# (see https://console.groq.com/docs/deprecations). Leave commented out
# (not just blank - an empty value still overrides the code default with
# an empty string) to use the built-in default.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional - only needed if you switch the provider to OpenAI from
# Django Admin (AI > AI provider & model). Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Payments (Paystack) ---
# Test-mode keys from https://dashboard.paystack.com/#/settings/developer
# (Settings -> API Keys & Webhooks). Use the TEST secret/public keys
# (sk_test_..., pk_test_...) while building - switch to live keys only when
# ready to accept real payments. Leave both blank for local dev and set
# ALLOW_MOCK_UPGRADE=true below to get the no-payment demo upgrade.
# REQUIRED for checkout, the referral bank list and payouts (503 without them):
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# LOCAL DEVELOPMENT ONLY. When true (and Paystack keys are NOT set), the
# Upgrade button grants Pro for free with no payment. Leave unset/false on
# any deployed environment - with it off and the keys missing, customers
# simply see "Payments are not available" instead of getting Pro free.
ALLOW_MOCK_UPGRADE=false

# Email (optional) - used to send invoices to customers.
# Leave EMAIL_HOST blank to have emails print to the console instead (fine for local dev).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@vendoriq.app

# --- Production tuning (optional) ---
# Redis URL to share one cache across every gunicorn worker/dyno. Leave blank
# to use a local in-memory cache (fine for a single instance).
REDIS_URL=
THROTTLE_RATE_ANON=30/min
THROTTLE_RATE_USER=300/min

# Login lockout - temporarily blocks further attempts against one EMAIL
# (not IP) after this many failed logins within the window, regardless of
# which IP they're coming from. Self-healing (no admin unlock needed) -
# see the longer comment in settings.py for why a permanent lockout would
# itself be a denial-of-service vector.
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
# Set to False once you've locked down exact production origins instead of
# allowing every *.vercel.app preview deployment.
CORS_ALLOW_VERCEL_PREVIEWS=True
WEB_CONCURRENCY=3
GUNICORN_THREADS=4

# --- Google sign-in (optional) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# ("OAuth client ID" -> "Web application"). Leave both blank to simply not
# offer Google sign-in - email/password login keeps working either way.
# See vendoriq-django/README.md "Google sign-in setup" for the full steps.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Billing / subscriptions ---
# Starting prices for the three Pro billing cycles, in KOBO (1 Naira = 100
# kobo), no separators - only used to seed the database the FIRST time the
# app runs for each cycle. After that, the actual price is a live setting
# controlled from Django Admin (Revenue & Billing > Plan prices), not these
# variables - change it there instead (by adding a new price version); it
# takes effect immediately for new purchases, no redeploy needed, and never
# retroactively changes what an existing subscriber is charged. See
# apps/billing/models.py::get_current_plan_price.
PRICE_MONTHLY_KOBO=500000
PRICE_SIX_MONTH_KOBO=1500000
PRICE_ANNUAL_KOBO=2400000

# Starting free-trial length in days - only used to seed the database the
# FIRST time the app runs. After that, the actual trial length is a live
# setting controlled from Django Admin (Revenue & Billing > Free trial
# length), not this variable - change it there instead; it takes effect
# immediately for every account, including ones currently mid-trial. See
# apps/billing/models.py::get_trial_period_days.
TRIAL_PERIOD_DAYS=30

# --- Error monitoring (optional) ---
# Create a free project at https://sentry.io, then Settings -> Client Keys
# (DSN) to get this URL. Leave blank to just not send error reports
# anywhere - the app behaves identically either way, this is purely additive.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_SEND_PII=False

# --- Added by the security pass ---
# How many reverse proxies sit in front of the app. Drives client-IP detection and rate limiting.
#   local development ........ 0
#   web app calls the API directly (VITE_API_URL set) ... 1   (Render only)
#   web app proxies /api through Vercel (RECOMMENDED, see below) ... 2   (Vercel, then Render)
# Too LOW buckets every visitor under the proxy's IP (one shared rate limit for everybody);
# too HIGH lets a client spoof its address through X-Forwarded-For.
NUM_PROXIES=0
# Set to False only for a local Postgres without SSL (production keeps True).
DB_SSL_REQUIRE=True
# Tighter per-user limits for costly endpoints (defaults shown).
THROTTLE_RATE_AI_CHAT=20/min
THROTTLE_RATE_INVOICE_SEND=30/hour
# NOTE: DEBUG now defaults to False when unset - keep DEBUG=True above for local dev only.

# --- SMS for phone verification (Termii, https://termii.com) ---
# Leave TERMII_API_KEY empty in local dev: codes are printed in the server log
# (and shown on the verify screen) instead of being texted. In production it
# MUST be set or phone verification returns "temporarily unavailable".
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert
TERMII_CHANNEL=dnd
# Access token lifetime in minutes (the app refreshes it silently).
ACCESS_TOKEN_MINUTES=60

# --- POS ---
# Biggest discount (% of a sale) a CASHIER may give; owners/managers are unlimited.
# Over-limit sales synced from an offline till are still recorded but flagged for review.
CASHIER_MAX_DISCOUNT_PERCENT=10
THROTTLE_RATE_BACKUP=6/hour

# --- Product photos (object storage) ---------------------------------------
# REQUIRED IN PRODUCTION: Render's disk is erased on every deploy, so without a bucket
# product photos disappear (a warning is printed by `manage.py check` / the build).
# Works with any S3-compatible store. Example for Supabase Storage (public bucket):
#   MEDIA_S3_BUCKET=product-photos
#   MEDIA_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
#   MEDIA_S3_ACCESS_KEY_ID=...      (Supabase -> Project settings -> Storage -> S3 connection)
#   MEDIA_S3_SECRET_ACCESS_KEY=...
#   MEDIA_S3_REGION=<your project region, e.g. eu-west-2>
#   MEDIA_S3_CUSTOM_DOMAIN=<project-ref>.supabase.co/storage/v1/object/public/product-photos
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_REGION=
MEDIA_S3_CUSTOM_DOMAIN=
# One small photo per product: incoming files above this are refused (default 1 MB).
PRODUCT_PHOTO_MAX_UPLOAD_BYTES=1048576

# --- Sign-in session: HttpOnly cookie ----------------------------------------------------------
# The refresh token lives in an HttpOnly cookie that page scripts cannot read; the browser keeps
# only a short-lived access token in memory. RECOMMENDED hosting: the web app proxies /api to this
# server (the rewrite in the frontend's vercel.json), so the browser sees ONE origin and the cookie is
# a plain first-party cookie - no CORS needed, set NUM_PROXIES=2 above.
#
# Alternative: custom same-site domains (app.example.com + api.example.com). Then set
#   CORS_ALLOW_CREDENTIALS=True   (exact origins only: the *.vercel.app wildcard is dropped automatically)
#   CORS_ALLOWED_ORIGINS=https://app.example.com
#   and give the frontend VITE_API_URL=https://api.example.com/api
# A cookie that must travel between UNRELATED sites (SameSite=None) is blocked by modern browsers.
AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=            # leave unset: a host-only cookie is the safest
# AUTH_COOKIE_SECURE=            # defaults to on whenever DEBUG is off (HTTPS only)
CORS_ALLOW_CREDENTIALS=False
# Sessions from before cookies existed migrate once (the app hands its old refresh token to the server,
# which moves it into the cookie). Set to False 30 days after deploying, when every old token has expired.
AUTH_ALLOW_BODY_REFRESH=True

# --- Product analytics (PostHog, optional) ---
# Server-side events: sign_up, email_verified, phone_verified, trial_started, subscription_purchased.
# Always on when a key is set (no opt-in). Use the SAME project key (phc_...) as the frontend's
# VITE_POSTHOG_KEY so browser and server events land on one person. Leave blank to disable.
POSTHOG_API_KEY=
# EU project: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
