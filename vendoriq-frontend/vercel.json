{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vendoriq-api.onrender.com/api/:path*"
    },
    {
      "source": "/ingest/static/:path*",
      "destination": "https://us-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://us.i.posthog.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
