# API address. LEAVE THIS UNSET (recommended): the app then calls /api on its own domain, which
# vercel.json proxies to the Render backend. That keeps the HttpOnly sign-in cookie first-party, so it
# works in every browser. (Local dev: vite.config.js already proxies /api to localhost:8000.)
# Only set it if the API lives on a SAME-SITE custom domain (app.example.com + api.example.com), and then
# the backend needs CORS_ALLOW_CREDENTIALS=True - see the backend .env.example "Sign-in session" section.
# VITE_API_URL=https://api.example.com/api

# Optional - only needed to show the "Continue with Google" button. Same
# Google Cloud OAuth client as GOOGLE_OAUTH_CLIENT_ID on the backend (the
# Client ID, not the secret - this one is safe to expose in frontend code,
# it's public by design). Leave blank to just not show the button.
VITE_GOOGLE_CLIENT_ID=

# --- Error monitoring (optional) ---
# Same Sentry project as the backend's SENTRY_DSN, but use the DSN from a
# separate JavaScript/React project in Sentry (not the Django one) - Sentry
# projects are per-platform. Leave blank to just not send error reports.
VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Payments (Paystack) ---
# No longer required here - UpgradeModal.jsx now gets the public key
# straight from the backend's /billing/paystack/initialize/ response
# (which reads PAYSTACK_PUBLIC_KEY server-side), so there's no separate
# frontend copy to keep in sync. Leaving this unset no longer disables
# real payments - only the backend's PAYSTACK_SECRET_KEY/PAYSTACK_PUBLIC_KEY
# being unset does that (the app then automatically falls back to the
# no-payment demo upgrade). Kept here only in case a future feature needs
# the key directly in the frontend.
VITE_PAYSTACK_PUBLIC_KEY=

# --- Product analytics (PostHog, optional) ---
# Leave VITE_POSTHOG_KEY blank to turn browser analytics off. When set, usage events are sent in the
# background for every visitor (no opt-in). Use the PROJECT API key (starts with phc_) - it is public by
# design, not a secret. The backend has the matching POSTHOG_API_KEY for sign-up / verification / trial /
# purchase events; use the same key in both so PostHog shows one person.
VITE_POSTHOG_KEY=
# Default '/ingest' = the same-origin proxy in vercel.json (recommended - ad-blockers rarely block it).
# VITE_POSTHOG_HOST=/ingest
# EU PostHog project? Also change BOTH "/ingest" destinations in vercel.json to eu.i.posthog.com and
# eu-assets.i.posthog.com, set VITE_POSTHOG_UI_HOST=https://eu.posthog.com, and POSTHOG_HOST on the backend.
# VITE_POSTHOG_UI_HOST=https://eu.posthog.com
